{
	"name": "workbench-monorepo",
	"version": "0.2.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"description": "Workbench monorepo — desktop, server, mobile, and shared packages",
	"type": "module",
	"packageManager": "bun@1.3.7",
	"workspaces": [
		"apps/*",
		"packages/*",
		"plugins/*"
	],
	"catalog": {
		"@lucide/svelte": "^1.56.0",
		"@sentry/vite-plugin": "5.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2.12.3",
		"@tauri-apps/cli": "^2.12.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.6.5",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"scripts": {
		"dev": "turbo run dev --filter=@workbench/desktop",
		"build": "turbo run build",
		"check": "turbo run check",
		"lint": "prettier --check . && turbo run lint",
		"format": "prettier --write .",
		"test": "turbo run test"
	},
	"devDependencies": {
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"turbo": "^2.11.7"
	}
}
